{
  "$defs": {
    "InputArtifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "InputArtifact",
      "type": "object"
    },
    "MethodProvenance": {
      "enum": [
        "HUMAN",
        "DETERMINISTIC_RULE",
        "HEURISTIC",
        "LLM",
        "EXTERNAL_PROVIDER",
        "COMPOSED"
      ],
      "title": "MethodProvenance",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": true,
      "properties": {
        "commit": {
          "minLength": 1,
          "title": "Commit",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "commit"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ScreeningBinding": {
      "additionalProperties": true,
      "properties": {
        "corpus_fingerprint": {
          "title": "Corpus Fingerprint",
          "type": "string"
        },
        "criteria_renderer_version": {
          "minLength": 1,
          "title": "Criteria Renderer Version",
          "type": "string"
        },
        "dedup_configuration_hash": {
          "title": "Dedup Configuration Hash",
          "type": "string"
        },
        "preparation_run_id": {
          "title": "Preparation Run Id",
          "type": "string"
        },
        "protocol_fingerprint": {
          "title": "Protocol Fingerprint",
          "type": "string"
        },
        "screening_run_id": {
          "title": "Screening Run Id",
          "type": "string"
        }
      },
      "required": [
        "screening_run_id",
        "protocol_fingerprint",
        "corpus_fingerprint",
        "criteria_renderer_version",
        "dedup_configuration_hash",
        "preparation_run_id"
      ],
      "title": "ScreeningBinding",
      "type": "object"
    },
    "ScreeningDecision": {
      "additionalProperties": true,
      "properties": {
        "decided_at": {
          "format": "date-time",
          "title": "Decided At",
          "type": "string"
        },
        "decision": {
          "$ref": "#/$defs/ScreeningDecisionValue"
        },
        "decision_id": {
          "title": "Decision Id",
          "type": "string"
        },
        "method": {
          "$ref": "#/$defs/MethodProvenance"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "parent_decision_ids": {
          "items": {
            "type": "string"
          },
          "title": "Parent Decision Ids",
          "type": "array"
        },
        "prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prompt Version"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "screener_id": {
          "minLength": 1,
          "title": "Screener Id",
          "type": "string"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        }
      },
      "required": [
        "decision_id",
        "study_id",
        "screener_id",
        "method",
        "decision",
        "reason",
        "decided_at"
      ],
      "title": "ScreeningDecision",
      "type": "object"
    },
    "ScreeningDecisionValue": {
      "enum": [
        "INCLUDE",
        "EXCLUDE",
        "MAYBE",
        "CONFLICT"
      ],
      "title": "ScreeningDecisionValue",
      "type": "string"
    },
    "ScreeningDecisionsData": {
      "additionalProperties": true,
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "binding": {
          "$ref": "#/$defs/ScreeningBinding"
        },
        "decisions": {
          "items": {
            "$ref": "#/$defs/ScreeningDecision"
          },
          "minItems": 1,
          "title": "Decisions",
          "type": "array"
        }
      },
      "required": [
        "binding",
        "batch_id",
        "decisions"
      ],
      "title": "ScreeningDecisionsData",
      "type": "object"
    }
  },
  "$id": "https://nexus-scholar.org/schemas/contracts/v1/screening-decisions.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "screening_decisions",
      "title": "Artifact Type",
      "type": "string"
    },
    "corpus_fingerprint": {
      "title": "Corpus Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ScreeningDecisionsData"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "title": "Inputs",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "protocol_fingerprint": {
      "title": "Protocol Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "workspace_id",
    "run_id",
    "protocol_fingerprint",
    "corpus_fingerprint",
    "data"
  ],
  "title": "ScreeningDecisionsArtifact",
  "type": "object"
}
