{
  "$defs": {
    "CorpusSnapshotData": {
      "additionalProperties": true,
      "properties": {
        "corpus_id": {
          "title": "Corpus Id",
          "type": "string"
        },
        "identity_algorithm_version": {
          "minLength": 1,
          "title": "Identity Algorithm Version",
          "type": "string"
        },
        "record_to_study": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Record To Study",
          "type": "object"
        },
        "studies": {
          "items": {
            "$ref": "#/$defs/CorpusStudy"
          },
          "minItems": 1,
          "title": "Studies",
          "type": "array"
        }
      },
      "required": [
        "corpus_id",
        "identity_algorithm_version",
        "studies",
        "record_to_study"
      ],
      "title": "CorpusSnapshotData",
      "type": "object"
    },
    "CorpusStudy": {
      "additionalProperties": true,
      "properties": {
        "alias_ids": {
          "items": {
            "type": "string"
          },
          "title": "Alias Ids",
          "type": "array"
        },
        "external_ids": {
          "additionalProperties": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "External Ids",
          "type": "object"
        },
        "publication_year": {
          "anyOf": [
            {
              "maximum": 9999,
              "minimum": 1000,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Publication Year"
        },
        "source_record_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Record Ids",
          "type": "array"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "source_record_ids",
        "title"
      ],
      "title": "CorpusStudy",
      "type": "object"
    },
    "InputArtifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "InputArtifact",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": true,
      "properties": {
        "commit": {
          "minLength": 1,
          "title": "Commit",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "commit"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "$id": "https://nexus-scholar.org/schemas/contracts/v1/corpus-snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "corpus_snapshot",
      "title": "Artifact Type",
      "type": "string"
    },
    "corpus_fingerprint": {
      "title": "Corpus Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/CorpusSnapshotData"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "title": "Inputs",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "protocol_fingerprint": {
      "title": "Protocol Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "workspace_id",
    "run_id",
    "protocol_fingerprint",
    "corpus_fingerprint",
    "data"
  ],
  "title": "CorpusSnapshotArtifact",
  "type": "object"
}
