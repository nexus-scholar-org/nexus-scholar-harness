{
  "$defs": {
    "DocumentContentStatus": {
      "enum": [
        "VALID",
        "PARTIAL",
        "FAILED",
        "NEEDS_OCR"
      ],
      "title": "DocumentContentStatus",
      "type": "string"
    },
    "DocumentManifestData": {
      "additionalProperties": true,
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentRecord"
          },
          "minItems": 1,
          "title": "Documents",
          "type": "array"
        }
      },
      "required": [
        "documents"
      ],
      "title": "DocumentManifestData",
      "type": "object"
    },
    "DocumentRecord": {
      "additionalProperties": true,
      "properties": {
        "content_status": {
          "$ref": "#/$defs/DocumentContentStatus"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "extracted_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extracted Path"
        },
        "extraction_method": {
          "$ref": "#/$defs/MethodProvenance"
        },
        "source_hash": {
          "title": "Source Hash",
          "type": "string"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "study_id",
        "source_hash",
        "content_status",
        "extraction_method"
      ],
      "title": "DocumentRecord",
      "type": "object"
    },
    "InputArtifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "InputArtifact",
      "type": "object"
    },
    "MethodProvenance": {
      "enum": [
        "HUMAN",
        "DETERMINISTIC_RULE",
        "HEURISTIC",
        "LLM",
        "EXTERNAL_PROVIDER",
        "COMPOSED"
      ],
      "title": "MethodProvenance",
      "type": "string"
    },
    "Producer": {
      "additionalProperties": true,
      "properties": {
        "commit": {
          "minLength": 1,
          "title": "Commit",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "commit"
      ],
      "title": "Producer",
      "type": "object"
    }
  },
  "$id": "https://nexus-scholar.org/schemas/contracts/v1/document-manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "document_manifest",
      "title": "Artifact Type",
      "type": "string"
    },
    "corpus_fingerprint": {
      "title": "Corpus Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/DocumentManifestData"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "title": "Inputs",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "protocol_fingerprint": {
      "title": "Protocol Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "workspace_id",
    "run_id",
    "protocol_fingerprint",
    "corpus_fingerprint",
    "data"
  ],
  "title": "DocumentManifestArtifact",
  "type": "object"
}
