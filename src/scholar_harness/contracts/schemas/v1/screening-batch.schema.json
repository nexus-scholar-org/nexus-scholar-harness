{
  "$defs": {
    "InputArtifact": {
      "additionalProperties": true,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256"
      ],
      "title": "InputArtifact",
      "type": "object"
    },
    "Producer": {
      "additionalProperties": true,
      "properties": {
        "commit": {
          "minLength": 1,
          "title": "Commit",
          "type": "string"
        },
        "package": {
          "minLength": 1,
          "title": "Package",
          "type": "string"
        },
        "version": {
          "minLength": 1,
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "package",
        "version",
        "commit"
      ],
      "title": "Producer",
      "type": "object"
    },
    "ScreeningBatchData": {
      "additionalProperties": true,
      "properties": {
        "batch_id": {
          "minLength": 1,
          "title": "Batch Id",
          "type": "string"
        },
        "batch_index": {
          "minimum": 0,
          "title": "Batch Index",
          "type": "integer"
        },
        "binding": {
          "$ref": "#/$defs/ScreeningBinding"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/ScreeningCandidate"
          },
          "minItems": 1,
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "binding",
        "batch_id",
        "batch_index",
        "candidates"
      ],
      "title": "ScreeningBatchData",
      "type": "object"
    },
    "ScreeningBinding": {
      "additionalProperties": true,
      "properties": {
        "corpus_fingerprint": {
          "title": "Corpus Fingerprint",
          "type": "string"
        },
        "criteria_renderer_version": {
          "minLength": 1,
          "title": "Criteria Renderer Version",
          "type": "string"
        },
        "dedup_configuration_hash": {
          "title": "Dedup Configuration Hash",
          "type": "string"
        },
        "preparation_run_id": {
          "title": "Preparation Run Id",
          "type": "string"
        },
        "protocol_fingerprint": {
          "title": "Protocol Fingerprint",
          "type": "string"
        },
        "screening_run_id": {
          "title": "Screening Run Id",
          "type": "string"
        }
      },
      "required": [
        "screening_run_id",
        "protocol_fingerprint",
        "corpus_fingerprint",
        "criteria_renderer_version",
        "dedup_configuration_hash",
        "preparation_run_id"
      ],
      "title": "ScreeningBinding",
      "type": "object"
    },
    "ScreeningCandidate": {
      "additionalProperties": true,
      "properties": {
        "abstract": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract"
        },
        "study_id": {
          "title": "Study Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "study_id",
        "title"
      ],
      "title": "ScreeningCandidate",
      "type": "object"
    }
  },
  "$id": "https://nexus-scholar.org/schemas/contracts/v1/screening-batch.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "artifact_id": {
      "title": "Artifact Id",
      "type": "string"
    },
    "artifact_type": {
      "const": "screening_batch",
      "title": "Artifact Type",
      "type": "string"
    },
    "corpus_fingerprint": {
      "title": "Corpus Fingerprint",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "data": {
      "$ref": "#/$defs/ScreeningBatchData"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/InputArtifact"
      },
      "title": "Inputs",
      "type": "array"
    },
    "producer": {
      "$ref": "#/$defs/Producer"
    },
    "protocol_fingerprint": {
      "title": "Protocol Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "title": "Schema Version",
      "type": "string"
    },
    "workspace_id": {
      "title": "Workspace Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "artifact_type",
    "artifact_id",
    "created_at",
    "producer",
    "workspace_id",
    "run_id",
    "protocol_fingerprint",
    "corpus_fingerprint",
    "data"
  ],
  "title": "ScreeningBatchArtifact",
  "type": "object"
}
