# Nexus Scholar — environment template.
# Copy this file to `.env` and fill in real values; the harness reads `.env`
# from where you run the kit commands (search settings use the SCHOLAR_ prefix).
# Secrets are NEVER written into project.json, protocol.json or audit/ — they
# live only in your local, git-ignored `.env`.

# --- Academic search providers (scholar-search-kit; SCHOLAR_* prefix) --------
SCHOLAR_MAILTO=you@example.com
SCHOLAR_OPENALEX_KEY=
SCHOLAR_S2_KEY=

# --- Model provider keys (OPTIONAL; LLM-backed screening / claim checks) -----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Nexus runtime (harness) --------------------------------------------------
# Grounded-recon cache root (CWD-independent); override per machine.
NEXUS_RECON_ROOT=.cache/inception_recon
# Optional skill source root for `nexus-scholar init` (directory of
# <skill-name>/SKILL.md). Defaults to the wheel bundle, else the repo checkout.
NEXUS_SKILLS_SRC=
