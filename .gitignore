# ==============================================================================
# Harness-Agri / Nexus-Scholar Git Ignore
# ==============================================================================

# Project Workspaces (Generated Research Runs)
# Track markdown, json, bibtex, and code while excluding heavy binary PDFs and vector stores
workspaces/**/pdfs/
workspaces/**/rag/chroma_db/
workspaces/**/chroma_db/

# Harness Console runtime state (job stdout, job dirs)
workspaces/**/.harness-console/

# External Plugins (installed via scripts/install_plugins.py)


# Scratch & Temporary Testing Scripts
scratch/
.cache/

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
/lib/
/lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & Coverage
.pytest_cache/
.pytest_temp/
tests_temp/
chroma_db/
.coverage
htmlcov/
.tox/
.nox/

# IDE & Editor Files
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini
